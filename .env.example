# ================================================================================
# SandboxHub 配置样例（对照 src/config.py 全量配置项）
# 复制为 .env 后按需修改；真实凭据绝不要提交进仓库。
# 每项标注：用途 / 默认值 / 私有化（客户内网离线机）部署建议。
# ================================================================================

# ── 服务监听与鉴权 ──────────────────────────────────────────────────────────────
# 服务端口。默认 8088。createrole 侧 SANDBOX_HUB_URL 须与此一致。
SANDBOX_HUB_PORT=8088
# 监听地址。默认 0.0.0.0（全网卡）。
# 私有化建议：若 createrole 与 SandboxHub 同机部署，收紧为 127.0.0.1；
# 跨机部署则绑定内网 IP，并务必同时配置 SANDBOX_HUB_API_KEY。
SANDBOX_HUB_HOST=0.0.0.0
# API Key（可选鉴权）。默认空 = 完全不鉴权（行为不变）。
# 非空时所有请求须带请求头 X-API-Key 且值匹配，否则 401；/v1/health 豁免（探活用）。
# createrole 客户端使用同名环境变量 SANDBOX_HUB_API_KEY 自动携带该头，两侧配同一个值即可。
# 私有化建议：必配（SandboxHub 等价于任意命令执行入口）。
SANDBOX_HUB_API_KEY=

# ── 镜像与预热池（每种 sandbox_type 一组）──────────────────────────────────────
# desktop profile：完整 GUI/computer-use。默认 sandbox-ubuntu:latest。
DOCKER_IMAGE_UBUNTU=sandbox-ubuntu:latest
# code profile：轻量无 GUI，仅终端/文件。默认 sandbox-code:latest。
DOCKER_IMAGE_CODE=sandbox-code:latest
# 预热容器数。默认 ubuntu=3、code=0（0=不预热，acquire 时冷启动）。
# 私有化建议：按客户机内存调低/调高；每个 ubuntu 容器 shm 2G + 桌面栈内存占用可观。
WARM_POOL_UBUNTU=3
WARM_POOL_CODE=0

# 受管容器标签（识别/对账用）。默认 sandboxhub.managed，一般不要改。
CONTAINER_LABEL=sandboxhub.managed
# 容器内沙盒 FastAPI 端口。默认 8000，与镜像 entrypoint 一致，一般不要改。
SANDBOX_API_PORT=8000
# 预热池补齐检查间隔（秒）。默认 30。
POOL_MAINTAIN_INTERVAL=30

# ── 沙盒对账与兜底回收 ──────────────────────────────────────────────────────────
# 周期对账间隔（秒）：清理已停止/孤儿容器、驱逐失联沙盒、闲置回收。默认 60。
RECONCILE_INTERVAL=60
# 已分配沙盒闲置回收阈值（秒）：超时未用即回收（挂载容器销毁、warm 容器复位回池）。
# 调用方按 (user, role) 幂等 acquire，回收后下一次调用自动重建。默认 7200，0=关闭。
SANDBOX_IDLE_TTL=7200
# 孤儿容器创建宽限（秒）：running 但不在册的受管容器，创建超过此时长才销毁。默认 300。
ORPHAN_GRACE_SECONDS=300

# ── 代理转发超时（秒）────────────────────────────────────────────────────────────
# 读超时须大于终端命令执行预算上限（300s）+ 回传余量，否则长命令被代理层掐断成 502。默认 330。
PROXY_READ_TIMEOUT=330
# 连接超时。默认 10。
PROXY_CONNECT_TIMEOUT=10

# ── 容器网络：Docker 网络 / 代理 / DNS ─────────────────────────────────────────
# 容器所在 Docker 网络。默认 bridge。自建网络（自定义网段）时改这里，
# 并注意 MINIO_ENDPOINT 里的网关 IP 也要跟着变（见下）。
SANDBOX_NETWORK=bridge
# 容器出网代理（可选）。默认空=不注入。只注入 ubuntu(desktop) 容器，code 容器不注入。
# 注意：容器内 127.0.0.1 是容器自身，不是宿主。宿主上的代理须监听容器可达的地址，
# 用 host.docker.internal 指向宿主，例：SANDBOX_HTTP_PROXY=http://host.docker.internal:8118
# 私有化建议：离线机通常留空；若客户内网有出网代理可配。
SANDBOX_HTTP_PROXY=
# 容器自定义 DNS（可选），逗号分隔，经 docker --dns 注入。默认空=用 Docker 默认 DNS。
# 私有化建议：配成客户内网 DNS，例：SANDBOX_DNS=10.0.0.2
# 注意：配置非空时会自动向容器注入 SANDBOX_KEEP_DNS=1，使 ubuntu 镜像 entrypoint
# 不再把 resolv.conf 覆写成 8.8.8.8/1.1.1.1（否则 --dns 不生效）。
SANDBOX_DNS=
# 强制保留 Docker 注入的 resolv.conf（不覆写为公网 DNS）。默认 false=保持现状
#（未配 SANDBOX_DNS 时 ubuntu 容器仍覆写为 8.8.8.8/1.1.1.1）。
# 私有化建议：设 true——离线机不可达公网 DNS，覆写会导致容器内域名解析全部超时；
# 设 true 后容器沿用宿主 Docker 的 DNS 配置（daemon.json / --dns）。
# 注意：该开关需配合重建后的沙盒镜像才生效（旧镜像 entrypoint 不识别此变量）。
SANDBOX_KEEP_DNS=false

# ── 工作区挂载（云盘 MinIO ↔ 容器互通）──────────────────────────────────────────
# 开启后，acquire 携带 workspace={bucket,prefix,mount_path} 时，在容器内用 rclone 把
# MinIO 的 bucket/prefix 实时挂到 mount_path（默认 /workspace）。需镜像内含 rclone+fuse3，
# 且宿主允许容器使用 /dev/fuse + SYS_ADMIN（本服务对挂载容器自动放开）。默认 true。
# 凭据留空 = 不具备挂载能力，acquire 里的 workspace 被忽略（记 warning 回退为不挂载）。
WORKSPACE_MOUNT_ENABLED=true
# MinIO 地址，host:port，不含 http:// 前缀。默认空=关闭挂载能力。
# 这里填的是「容器内可达」的地址：172.17.0.1 是 Docker 默认 bridge 网桥的宿主网关写法，
# 宿主上跑的 MinIO 用它即可被容器访问；换机器/自建 Docker 网络（网段不同）/MinIO 在别的
# 主机时必须相应改为实际可达地址。
# 必须与 createrole 侧（MINIO_* 配置）指向同一 MinIO 实例，否则云盘与沙盒看到的不是同一份文件。
# 例：MINIO_ENDPOINT=172.17.0.1:9000
MINIO_ENDPOINT=
# MinIO 凭据（传给容器内 rclone，经环境变量内联不落盘）。真实值只写进 .env，不入样例。
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# true=https 访问 MinIO。默认 false。
MINIO_SECURE=false

# ── rclone VFS（一致性/吞吐权衡，一般无需改）──────────────────────────────────
# VFS 缓存模式。默认 full：对 rename/并发读写支持最完整；writes 模式下写回窗口内的
# rename-over（sed -i / mv 覆盖）会报 EIO（issue #9），勿改回 writes。
RCLONE_VFS_CACHE_MODE=full
# full 模式本地读缓存体积上限（防大文件读放大占满容器磁盘）。默认 2G。
RCLONE_VFS_CACHE_MAX_SIZE=2G
# 文件关闭后回写 MinIO 的延迟（越小越接近实时）。默认 1s。
RCLONE_VFS_WRITE_BACK=1s
# 目录列表缓存时长（影响 MinIO→容器可见延迟）。默认 2s。
RCLONE_DIR_CACHE_TIME=2s
# 挂载就绪探测：mountpoint 轮询次数与间隔（秒）。默认 20 次 × 0.5s。
MOUNT_READY_RETRIES=20
MOUNT_READY_INTERVAL=0.5
