# =============================================================================
# SandboxHub .env 样例（复制为仓库根 .env 后按环境填写；不进 Git）
#
# .env 只放最底层信息：本机属性、网络属性、对象存储连接、密钥。
# 不在这里的（issue #28，对齐 createrole#400）：镜像名 / 预热池 / 对账回收 / 代理超时 /
# rclone 挂载策略等系统调优在 config/system.yaml（进 git，改动走 PR）。
# 旋钮的同名旧 ENV 已退役：启动期告警并忽略。各键含义见 src/config.py 与 README。
# =============================================================================

# ── 1. 本机 ──────────────────────────────────────────────────────────────────
# v2 要求只绑本机回环（并配置下方 SANDBOX_HUB_API_KEY），否则 /v2/capabilities 判不安全。
SANDBOX_HUB_HOST=127.0.0.1
SANDBOX_HUB_PORT=8088
CONTAINER_LABEL=sandboxhub.managed
# v2 宿主数据根（工作区、实例 inputs/context、blob 缓存、角色目录挂载点）。空 = 仓库下
# var/sandboxhub。须在 shared 挂载传播的文件系统上，且不要放根分区（容量）。
# 生产：/data/disk2/createrole/var/sandboxhub
WORK_AREA_ROOT=

# ── 2. 网络 ──────────────────────────────────────────────────────────────────
# 联网态网络：须是用户自定义 bridge 网络（Hub 启动时自动创建）。配成 Docker 内置 bridge
# 则网络策略不可用（acquire 请求 deny 被 400 拒绝）。
SANDBOX_NETWORK=cr-sb-net
# 断网态网络（--internal，Hub 自动创建）：策略 deny 的沙盒热切到这里，只能到达 cr-host
SANDBOX_NETWORK_ISOLATED=cr-sb-isolated
# 网关容器名 = 容器内访问 MinIO / createrole API 的固定主机名（两张网都能解析）
SANDBOX_GATEWAY_NAME=cr-host
# 网关额外转发：listen=宿主可达地址:port（逗号分隔）；MinIO 按 MINIO_ENDPOINT 自动加入。
# createrole 侧 SANDBOX_MARKET_CLI_API_BASE=http://cr-host:8012 时这里须转发 8012。
SANDBOX_GATEWAY_FORWARDS=8012=host.docker.internal:8012
SANDBOX_HTTP_PROXY=
SANDBOX_DNS=
SANDBOX_KEEP_DNS=false
# v2 隔离白名单：实例默认连不上宿主端口 / 其他沙盒 / 私网，只能经网关。按需放行：
# 宿主端口（逗号分隔；SANDBOX_HTTP_PROXY 指向 host.docker.internal 时其端口自动放行）
NETGUARD_HOST_ALLOW_PORTS=
# 私网 CIDR（逗号分隔，如内网镜像源）
NETGUARD_EGRESS_ALLOW_CIDRS=

# ── 3. 对象存储连接（须与 createrole 侧 MINIO_* 指向同一实例）────────────────
# MINIO_ENDPOINT 写「宿主可达」地址（网关容器从宿主侧转发，容器内经 cr-host:<port> 访问；
# host.docker.internal 即宿主）。SANDBOX_NETWORK 为内置 bridge 时才需写容器内可达地址。
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false

# ── 4. 密钥 ──────────────────────────────────────────────────────────────────
SANDBOX_HUB_API_KEY=
