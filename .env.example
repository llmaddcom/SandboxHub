# SandboxHub Configuration

SANDBOX_HUB_PORT=8088
SANDBOX_NETWORK=bridge

# 镜像与预热池（每种 sandbox_type 一组）
DOCKER_IMAGE_UBUNTU=sandbox-ubuntu:latest   # desktop profile：完整 GUI/computer-use
DOCKER_IMAGE_CODE=sandbox-code:latest        # code profile：轻量无 GUI，仅终端/文件
WARM_POOL_UBUNTU=3
WARM_POOL_CODE=0                              # 0=不预热，acquire 时冷启动

CONTAINER_LABEL=sandboxhub.managed
SANDBOX_API_PORT=8000
POOL_MAINTAIN_INTERVAL=30

# 容器代理（可选）。留空=不注入代理。
# 注意：容器内 127.0.0.1 是容器自身，不是宿主。宿主上的代理须监听容器可达的地址，
# 然后用 host.docker.internal 指向宿主，例：
# SANDBOX_HTTP_PROXY=http://host.docker.internal:8118
SANDBOX_HTTP_PROXY=

# 容器自定义 DNS（可选），逗号分隔。留空=用 Docker 默认 DNS。
# SANDBOX_DNS=202.96.209.5,114.114.114.114
SANDBOX_DNS=

# ── 工作区挂载（云盘 MinIO ↔ 容器互通）──────────────────────────────────────────
# 开启后，acquire 携带 workspace={bucket,prefix,mount_path} 时，在容器内用 rclone 把
# MinIO 的 bucket/prefix 实时挂到 mount_path（默认 /workspace）。需镜像内含 rclone+fuse3，
# 且宿主允许容器使用 /dev/fuse + SYS_ADMIN（本服务对挂载容器自动放开）。
# 凭据留空 = 不具备挂载能力，acquire 里的 workspace 被忽略（记 warning 回退为不挂载）。
WORKSPACE_MOUNT_ENABLED=true
MINIO_ENDPOINT=                # host:port，例：minio:9000（不含 http:// 前缀）
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false             # true=https
# rclone VFS（一致性/吞吐权衡，一般无需改）
RCLONE_VFS_CACHE_MODE=writes
RCLONE_VFS_WRITE_BACK=1s
RCLONE_DIR_CACHE_TIME=2s
